alias restore="$HOME/Desktop/scripts/recycle_bin/recycle_bin.sh restore"
alias empty="$HOME/Desktop/scripts/recycle_bin/recycle_bin.sh empty"

alias sswitch="$HOME/Desktop/scripts/switch_format/switch_format.sh" # style switch

alias map="$HOME/Desktop/scripts/map.sh"

alias cformat="$HOME/Desktop/scripts/mapclgf.sh"

alias cheader="$HOME/Desktop/scripts/make_header.sh"

alias switch="$HOME/Desktop/scripts/switch_format/switch_format.sh"

alias work="$HOME/Desktop/scripts/piscine_framework/piscine_manager.sh"

